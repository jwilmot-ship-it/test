# -----------------------------------------------------------------------
# Gong API credentials
# Obtain from: Gong > Settings > Technical Settings > API
# -----------------------------------------------------------------------
GONG_ACCESS_KEY=your_access_key_here
GONG_ACCESS_SECRET=your_access_secret_here

# -----------------------------------------------------------------------
# Salesforce credentials
# Use a dedicated integration user with read access to Opportunity, Account,
# and User objects (including the custom fields listed below).
# -----------------------------------------------------------------------
SALESFORCE_USERNAME=user@yourorg.com
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_security_token
# Set to "test" for sandbox, "login" for production
SALESFORCE_DOMAIN=login

# -----------------------------------------------------------------------
# Email (SMTP) settings
# The following defaults work for Gmail with an App Password.
# For other providers adjust SMTP_HOST / SMTP_PORT accordingly.
# -----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@canva.com
SMTP_PASSWORD=your_app_password_or_smtp_password
EMAIL_FROM=sales-ops@canva.com

# -----------------------------------------------------------------------
# Slack Bot Token
# Create a Slack App with the following bot token scopes:
#   - chat:write       (send DMs)
#   - users:read       (look up users)
#   - users:read.email (look up users by email)
# Obtain the Bot User OAuth Token from: api.slack.com > Your App > OAuth & Permissions
# -----------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# -----------------------------------------------------------------------
# Webhook security
# A shared secret included in every POST from Salesforce so the server can
# verify the request is genuine.  Set the same value in your Salesforce Flow.
# Leave blank to disable the check (not recommended for production).
# -----------------------------------------------------------------------
WEBHOOK_SECRET=choose_a_strong_random_secret

# -----------------------------------------------------------------------
# Server settings
# -----------------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
